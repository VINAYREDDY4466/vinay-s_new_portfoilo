{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "vinay-s-new-portfoilo",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown page paths (e.g. /contact) serve index.html so the React app can route them.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      // Wrangler creates this database automatically on the first deploy.
      "binding": "DB",
      "database_name": "portfolio-messages"
    }
  ]
  // Secrets — set in the Cloudflare dashboard (prod) or .dev.vars (local), never here:
  // ADMIN_PASSWORD (required), TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID (optional alerts).
}
